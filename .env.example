GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
API_FOOTBALL_KEY=your-api-football-key
AUTO_GENERATE=true
GENERATION_INTERVAL_MINUTES=30

# Frontend — demo mode
# "true" makes the React app serve the generated dataset in frontend/src/demo
# instead of calling the backend. Used by the hosted build while the API is
# switched off. Leave unset for local development against a live backend.
VITE_DEMO_MODE=false
